<!DOCTYPE html>
<html>
<head>
    <title>Healthy Recipes</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f1f8f1;
        }

        header {
            background-color: #2e8b57;
            color: white;
            text-align: center;
            padding: 20px;
        }

        nav {
            background-color: #225c3c;
            padding: 12px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        section {
            padding: 20px;
        }

        h2 {
            color: #2e8b57;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
        }

        .card {
            background-color: white;
            width: 250px;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 2px 8px gray;
        }

        .card img {
            width: 100%;
            height: 160px;
            border-radius: 8px;
        }

        .card h3 {
            color: #2e8b57;
        }

        footer {
            background-color: #225c3c;
            color: white;
            text-align: center;
            padding: 15px;
        }

        @media (max-width: 600px) {
            .card {
                width: 90%;
            }

            nav a {
                display: inline-block;
                margin: 8px;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <h1>Healthy Recipes</h1>
        <p>Eat Healthy, Stay Healthy!</p>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a>
        <a href="#recipes">Recipes</a>
        <a href="#meal">Meal Plan</a>
        <a href="#tips">Health Tips</a>
    </nav>

    <!-- Home Section -->
    <section id="home">
        <h2>Welcome to Healthy Recipes</h2>
        <p>
            Healthy food helps us stay active and strong.
            Explore nutritious recipes, ingredients and
            simple meal plans for a healthy lifestyle.
        </p>
    </section>

    <!-- Food Categories -->
    <section>
        <h2>Food Categories</h2>

        <div class="container">

            <div class="card">
                <h3>Fruits</h3>
                <p>Apple, Banana, Orange and Mango.</p>
            </div>

            <div class="card">
                <h3>Vegetables</h3>
                <p>Carrot, Spinach, Tomato and Broccoli.</p>
            </div>

            <div class="card">
                <h3>Healthy Grains</h3>
                <p>Oats, Brown Rice and Wheat.</p>
            </div>

            <div class="card">
                <h3>Nuts</h3>
                <p>Almonds, Walnuts and Cashews.</p>
            </div>

        </div>
    </section>

    <!-- Recipes Section -->
    <section id="recipes">
        <h2>Healthy Recipes</h2>

        <div class="container">

            <!-- Recipe 1 -->
            <div class="card">
                <img src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=500"
                alt="Vegetable Salad">

                <h3>Vegetable Salad</h3>

                <p><b>Ingredients:</b></p>
                <p>Carrot, Tomato, Cucumber and Lemon.</p>

                <p><b>Calories:</b> Approximately 120 kcal</p>

                <p>Mix all vegetables and add lemon juice.</p>
            </div>

            <!-- Recipe 2 -->
            <div class="card">
                <img src="https://images.unsplash.com/photo-1517673132405-a56a62b18caf?w=500"
                alt="Oatmeal">

                <h3>Healthy Oats</h3>

                <p><b>Ingredients:</b></p>
                <p>Oats, Milk, Banana and Almonds.</p>

                <p><b>Calories:</b> Approximately 250 kcal</p>

                <p>Cook oats with milk and add fruits.</p>
            </div>

            <!-- Recipe 3 -->
            <div class="card">
                <img src="https://images.unsplash.com/photo-1547592180-85f173990554?w=500"
                alt="Healthy Soup">

                <h3>Vegetable Soup</h3>

                <p><b>Ingredients:</b></p>
                <p>Carrot, Tomato, Onion and Pepper.</p>

                <p><b>Calories:</b> Approximately 100 kcal</p>

                <p>Boil vegetables and add salt and pepper.</p>
            </div>

        </div>
    </section>

    <!-- Meal Plan -->
    <section id="meal">
        <h2>Daily Meal Plan</h2>

        <div class="container">

            <div class="card">
                <h3>Breakfast</h3>
                <p>Milk, Oats and Banana.</p>
            </div>

            <div class="card">
                <h3>Lunch</h3>
                <p>Rice, Dal and Vegetables.</p>
            </div>

            <div class="card">
                <h3>Evening Snacks</h3>
                <p>Fruits and Nuts.</p>
            </div>

            <div class="card">
                <h3>Dinner</h3>
                <p>Chapati and Vegetable Curry.</p>
            </div>

        </div>
    </section>

    <!-- Healthy Tips -->
    <section id="tips">
        <h2>Healthy Eating Tips</h2>

        <ul>
            <li>Eat fresh fruits and vegetables.</li>
            <li>Drink enough water.</li>
            <li>Eat a balanced diet.</li>
            <li>Avoid eating too much junk food.</li>
            <li>Never skip regular meals.</li>
            <li>Include protein-rich foods in your diet.</li>
        </ul>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Healthy Recipes Website</p>
        <p>Eat Healthy, Live Healthy!</p>
    </footer>

</body>
</html>
